{
  "name": "app-desktop-helper-notes",
  "main": "electron-dist/main.js",
  "version": "1.0.0",
  "author": "Schavez",
  "description": "Aplicación de escritorio para crear y organizar notas, documentos y presentaciones.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "watch": "ng build --watch --configuration development",
    "electron": "ng build && npm run electron:build && electron .",
    "build:electron": "node scripts/build-current-platform.js",
    "electron:build": "tsc -p electron/tsconfig.json",
    "format": "prettier --write \"electron/**/*.{ts,js}\" \"src/**/*.{ts,html,scss}\"",
    "electron:run": "electron electron-dist/main.js",
    "electron:dev": "concurrently \"ng serve\" \"npm run electron:build -- --watch\" \"wait-on http://localhost:4200 && cross-env ELECTRON_DEV_URL=http://localhost:4200 electron electron-dist/main.js\"",
    "dist:win": "node scripts/build-win.js",
    "dist:linux": "node scripts/build-platform.js linux",
    "dist:linux:x64": "node scripts/build-platform.js linux x64",
    "dist:linux:arm64": "node scripts/build-platform.js linux arm64",
    "dist:mac": "node scripts/build-platform.js mac",
    "dist:mac:x64": "node scripts/build-platform.js mac x64",
    "dist:mac:arm64": "node scripts/build-platform.js mac arm64"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "build": {
    "afterPack": "scripts/edit-windows-executable.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "appId": "com.schavez.helper-notes",
    "productName": "Helper Notes",
    "artifactName": "Helper-Notes-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": true,
    "extraResources": [],
    "win": {
      "signAndEditExecutable": false,
      "target": "nsis",
      "icon": "assets/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Helper Notes ${version}",
      "artifactName": "Helper-Notes-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/favicon.png",
      "category": "Office",
      "maintainer": "Schavez",
      "executableName": "helper-notes",
      "synopsis": "Notas, documentos y asistencia local"
    },
    "nsis": {
      "include": "build/file-associations.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@docx-editor.dev/core": "2.30.0",
    "@docx-editor.dev/i18n": "2.30.0",
    "@docx-editor.dev/vue": "2.30.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^12.6.2",
    "docx-preview": "^0.4.1",
    "dotenv": "^17.2.2",
    "fflate": "^0.8.3",
    "pptxgenjs": "^4.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vue": "3.5.44",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.4"
  }
}
